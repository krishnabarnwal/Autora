# ---------------------------------------------------------------------------
# Autonomous AI Creator - environment template
# Copy this file to server/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string, or a local mongod URI. REQUIRED in production.
# Replace <password> with the real password, URL-encoding any special characters.
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/autonomous_ai_creator?appName=Cluster0
MONGODB_URI=

# Local testing escape hatch ONLY: runs an in-process ephemeral MongoDB when
# MONGODB_URI is unset. All data is lost on shutdown. Startup fails if this is
# set while NODE_ENV=production or AGENT_MODE=production.
USE_EPHEMERAL_DB=false

# Optional. Only needed if your network's local resolver cannot answer the SRV
# lookups that mongodb+srv:// requires (symptom: "querySrv ECONNREFUSED").
# Comma-separated. Leave empty to use system DNS.
DNS_SERVERS=

# --- LLM provider ---------------------------------------------------------
# Which provider adapter to use: gemini | mock
LLM_PROVIDER=gemini
# API key for the selected provider. Never hardcode this in source.
LLM_API_KEY=
# Model id for the selected provider. Google retires older ids for new keys, so
# if a call fails with HTTP 404 "no longer available to new users", pick a
# current one rather than assuming the key is bad.
LLM_MODEL=gemini-3.5-flash

# --- Breeth strategic memory (OPTIONAL) -----------------------------------
# Phase 12.5. Entirely optional: MongoDB remains the authoritative memory for
# duplicate prevention and repetition checks. Breeth only adds cross-cycle
# strategic recall. Disabled, unreachable, or unkeyed, the agent runs exactly as
# before and no cycle ever fails because of it.
BREETH_ENABLED=false
# Server-side only. Never commit a real key and never expose it to the client.
# Needs `read` (implicit on every key) and `write` scope for episodes.
# Admin scope (retract, tasks, key management) is NOT used.
BREETH_API_KEY=
# How long one Breeth request may take before it is abandoned. Kept short: an
# optional memory write must never stall an autonomous cycle.
BREETH_TIMEOUT_MS=3000

# --- Agent runtime --------------------------------------------------------
# demo       -> autonomous cycle every ~45 seconds (live demonstrations)
# production -> autonomous cycle every ~6 hours (48h evaluation window)
AGENT_MODE=demo

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins for the API.
CORS_ORIGIN=http://localhost:5173
